# Dev-friendly env: SQLite + optional Redis (can be absent)
PYTHONPATH=src

APP_ENV=development
DEBUG=True

APP_TITLE=FastAPI Dev
PROJECT_NAME=FastAPI Dev
APP_DESCRIPTION=FastAPI Dev Local
VERSION=0.1.0

# Auth & Swagger
SECRET_KEY=dev_secret_key_change_me_please_32_chars_min
SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=devpassword
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# Database: use local sqlite file
DB_ENGINE=sqlite
DB_NAME=fastapi_dev.sqlite3
# PG vars kept for completeness but unused in sqlite mode
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# Redis: ok if unavailable; logs a warning only
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# CORS for local frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
